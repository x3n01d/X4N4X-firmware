  COMMAND = cd /src/build/Service/App && /usr/bin/cmake -E echo No\ interactive\ CMake\ dialog\ available.
  DESC = No interactive CMake dialog available...
  restat = 1

build App/edit_cache: phony App/CMakeFiles/edit_cache.util


